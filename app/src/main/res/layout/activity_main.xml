<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#09090d" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="MOORTY VOICE" android:textColor="#ff3048" android:textSize="29sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:text="YOUTUBE + TIKTOK LIVE • ANDROID" android:textColor="#aaaaaa" android:textSize="12sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="22dp" android:text="PLATAFORMA" android:textColor="#ffffff" android:textStyle="bold" />
        <Spinner android:id="@+id/platformSpinner" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="5dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:text="CUENTA TIKTOK" android:textColor="#ffffff" android:textStyle="bold" />
        <Spinner android:id="@+id/accountSpinner" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="5dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:text="CONEXIÓN YOUTUBE LIVE" android:textColor="#ff5366" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="5dp" android:text="API key de YouTube Data API v3" android:textColor="#eeeeee" />
        <EditText android:id="@+id/apiKeyInput" android:layout_width="match_parent" android:layout_height="52dp"
            android:hint="Introduce tu API key" android:singleLine="true" android:inputType="textPassword"
            android:textColor="#ffffff" android:textColorHint="#888888" android:backgroundTint="#ff3048" android:autofillHints=""/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="ID DEL CANAL (normalmente empieza por UC)" android:textColor="#eeeeee" />
        <EditText android:id="@+id/channelIdInput" android:layout_width="match_parent" android:layout_height="52dp"
            android:hint="UC..." android:singleLine="true" android:inputType="text"
            android:textColor="#ffffff" android:textColorHint="#888888" android:backgroundTint="#ff3048" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:text="EVENTOS PARA LEER EN VOZ ALTA" android:textColor="#ffffff" android:textStyle="bold" />
        <CheckBox android:id="@+id/commentsCheck" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Comentarios del chat" android:checked="true" android:textColor="#eeeeee" />
        <CheckBox android:id="@+id/giftsCheck" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Membresías, membresías regaladas, Super Chats y Super Stickers" android:checked="true" android:textColor="#eeeeee" />
        <CheckBox android:id="@+id/likesCheck" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Likes (TikTok, si el conector los entrega)" android:checked="false" android:textColor="#eeeeee" />
        <CheckBox android:id="@+id/followsCheck" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nuevos seguidores (TikTok, si disponible)" android:checked="true" android:textColor="#eeeeee" />
        <CheckBox android:id="@+id/sharesCheck" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Compartidos (TikTok, si disponible)" android:checked="false" android:textColor="#eeeeee" />
        <CheckBox android:id="@+id/joinsCheck" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Entradas al directo (TikTok, si disponible)" android:checked="false" android:textColor="#eeeeee" />
        <Button android:id="@+id/testVoiceButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="15dp" android:text="♫  PROBAR VOZ" />
        <Button android:id="@+id/startButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:text="▶  CONECTAR YOUTUBE LIVE" />
        <Button android:id="@+id/stopButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:text="■  DETENER" />
        <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="15dp" android:padding="14dp" android:background="#1b1b23"
            android:text="Estado: listo para conectar" android:textColor="#ffb4b4" android:textSize="14sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="15dp" android:text="YouTube: lee mensajes nuevos, eventos de membresía/Super Chat que aparezcan en el chat y cambios del contador de espectadores cuando la API los expone. Las alertas de suscripción normal requieren OAuth; la API key sola no las habilita. TikTok requiere una integración compatible independiente." android:textColor="#999999" android:textSize="12sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:text="La API key se guarda localmente en este teléfono. No compartas el APK con tu clave guardada." android:textColor="#999999" android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
